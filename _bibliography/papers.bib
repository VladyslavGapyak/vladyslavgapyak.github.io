@article{marz2022amee,
    author = {März, Thomas and Gapyak, Vladyslav and Weinmann, Andreas},
    title = {{A Two-Stage Model-Based Regularized Reconstruction Approach for Magnetic Particle Imaging}},
    journal = {AIP Conference Proceedings},
    volume = {2939},
    number = {1},
    pages = {100008},
    year = {2023},
    month = {12},
    issn = {0094-243X},
    doi = {10.1063/5.0178921},
    abstract = {Magnetic Particle Imaging (MPI) is an emerging imaging modality and is currently a very active field of research. In the multivariate MPI setup images are usually reconstructed using a system matrix which is obtained by a time-consuming measurement procedure. We approach the reconstruction problem by employing a mathematical model which we introduced in an earlier work and which is based on the MPI signal encoding. Here, we present an enhanced two-stage reconstruction algorithm derived from the decomposition of the imaging process provided by the model. In the first stage of the algorithm we propose a variational formulation together with adequate regularization which improves our reconstruction results.}
}
@article{marz2022icnaam,
    author = {März, Thomas and Gapyak, Vladyslav and Weinmann, Andreas},
    title = {{A Flexible Model-Based Regularized Reconstruction Approach for Magnetic Particle Imaging}},
    journal = {AIP Conference Proceedings},
    volume = {3094},
    number = {1},
    pages = {440001},
    year = {2024},
    month = {06},
    issn = {0094-243X},
    doi = {10.1063/5.0212522},
    abstract={Magnetic Particle Imaging (MPI) is an emerging imaging modality and a very active field of research. In the multivariate MPI setup images are usually reconstructed using a system matrix which is obtained by a time-consuming measurement procedure. We approach the reconstruction problem by employing a mathematical model which is based on the MPI signal encoding and the properties of the MPI Core Operator. Here, we present a reconstruction algorithm which features two stages: in the first stage, we estimate components of the MPI Core Operator by using a variational formulation. In the second stage, the image is reconstructed by regularized deconvolution applied to the components of the MPI Core Operator robustly estimated in the first stage. We demonstrate the potential of our algorithm with examples.}
}

@article{gapyak2022icnaam,
    author = {Gapyak, Vladyslav and März, Thomas and Weinmann, Andreas},
    title = {{Quality-Enhancing Techniques for a Two-Stage Model-Based Approach for Magnetic Particle Imaging}},
    journal = {AIP Conference Proceedings},
    volume = {3094},
    number = {1},
    pages = {440002},
    year = {2024},
    month = {06},
    issn = {0094-243X},
    doi = {10.1063/5.0213070},
    abstract={Magnetic Particle Imaging is a scanning modality that exploits the response of superparamagnetic nanoparticles to a dynamic magnetic field. In the multivariate case measurement-based reconstruction approaches are common and involve a system-matrix whose acquisition is time consuming and needs to be repeated whenever the scanning setup changes. Our approach uses a mathematical model, based on the MPI encoding of the signal, that is in particular independent of the scanning trajectories. We present basic ways of leveraging this independence property to enhance the quality of the reconstruction by using data from different scans. We demonstrate the potential of our approach with examples.}
}

@article{gapyak2023amee,
    author = {Gapyak, Vladyslav and März, Thomas and Weinmann, Andreas},
    title = {{Model-based reconstruction of 2D distributions from 1D multi-patch data in magnetic particle imaging}},
    journal = {AIP Conference Proceedings},
    volume = {3182},
    number = {1},
    pages = {090010},
    year = {2025},
    month = {03},
    abstract = {Magnetic Particle Imaging is a novel imaging modality based on the application of dynamic magnetic fields to distributions of superparamagnetic nanoparticles. The voltage induced in receiving coils in the scanner constitutes the signal from which the distribution of the particles is to be reconstructed. The spatial coverage of the trajectories employed is limited and multi-patching approaches to cover big specimens are necessary. Moreover, the usage of 1D scan sequences for 2D distributions does not allow for a complete reconstruction of the fundamental MPI Core Operator, necessary for a model-based reconstruction. In this work we describe how the combination of a general multi-patch framework with a two stage algorithm can be employed to achieve good reconstructions even with partial knowledge of the MPI Core Operator and how 1D scans can be merged to construct 2D data sets that give full knowledge of the MPI Core Operator and lead to enhanced quality in the reconstructions.},
    issn = {0094-243X},
    doi = {10.1063/5.0245985},
    url = {https://doi.org/10.1063/5.0245985},
    eprint = {https://pubs.aip.org/aip/acp/article-pdf/doi/10.1063/5.0245985/20461209/090010\_1\_5.0245985.pdf},
}

